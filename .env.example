# ============================================================
# TeamReach — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- Supabase (required) -----------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ---- Mixpanel (analytics) ----------------------------------
# Get from: Mixpanel → Project Settings → Project Token
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# ---- Amplitude (analytics) ---------------------------------
# Get from: Amplitude → Settings → Projects → your project → API Key
VITE_AMPLITUDE_API_KEY=your-amplitude-api-key

# ============================================================
# Supabase Edge Function secrets
# Set via: supabase secrets set KEY=value
# Or via:  Supabase Dashboard → Edge Functions → Secrets
# ============================================================

# ALLOWED_ORIGINS=
#   Comma-separated allowed CORS origins for edge functions.
#   Use * in development. Set to your production domain in prod.
#   Example: https://teamreach.app

# ============================================================
# Admin role for EMAIL users
# ============================================================
# Email users get the "user" (participant) role by default.
# To promote an email user to admin, run in Supabase SQL Editor:
#
#   INSERT INTO public.user_roles (user_id, role)
#   VALUES ('<UUID from auth.users>', 'admin')
#   ON CONFLICT (user_id, role) DO NOTHING;
#
# Or: Supabase Dashboard → Table Editor → user_roles → Insert row
